{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "EXPO_ENV=production npx expo export --platform web --output-dir dist",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": null,
  "rewrites": [
    { "source": "/admin", "destination": "https://port-0-connect-service-mahm3yer16ed563d.sel4.cloudtype.app/admin/" },
    { "source": "/admin/", "destination": "https://port-0-connect-service-mahm3yer16ed563d.sel4.cloudtype.app/admin/" },
    { "source": "/admin/:path*", "destination": "https://port-0-connect-service-mahm3yer16ed563d.sel4.cloudtype.app/admin/:path*" },
    { "source": "/api/admin/:path*", "destination": "https://port-0-connect-service-mahm3yer16ed563d.sel4.cloudtype.app/api/admin/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
